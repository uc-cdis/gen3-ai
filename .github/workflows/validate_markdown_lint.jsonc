// Ruleset for markdownlint, shared by `just markdown_lint` and the
// `uc-cdis/.github` reusable markdown workflow.
//
// WARNING: CI overwrites this file at runtime via wget from
// uc-cdis/.github/.github/workflows/validate_markdown_lint.jsonc.
// This copy exists so the same rules apply locally. If CI starts failing on
// rules that pass locally, re-sync this file from upstream.
{
  // Default state for all rules
  "default": true,
  "blanks-around-fences": false,
  "blanks-around-lists": false,
  "code-block-style": false,
  "fenced-code-language": false,
  "line-length": false,
  "no-bare-urls": false,
  "no-multiple-blanks": false,
  "ul-style": false
}
