ARG AZLINUX_BASE_VERSION=3.13-pythonuv
ARG SERVICE_NAME
# Pinned to match DBMATE_VERSION in .github/workflows/tests_and_build.yml, so the binary that
# runs migrations in the init container is the one CI validated them against.
#
# Kept current by `just update_versions`. To hold it back when the latest is broken, put
# `# allow-old-version` on its own line above the ARG; Docker treats a mid-line `#` as an
# argument, not a comment, so it cannot go inline the way it does in the workflows.
#
# IMPORTANT: If you are reading this and `# allow-old-version` is present, try removing it and
# running `just update_versions` and if CI passes, leave it off! We want to stay up to date.
ARG DBMATE_VERSION=2.35.1

# Named stage because --from does not expand build arguments inline.
FROM ghcr.io/amacneil/dbmate:${DBMATE_VERSION} AS dbmatebin

# Base image: tooling and environment only. Application sources are deliberately not copied
# here, so that a source-only change cannot invalidate the dependency layer in `builder`.
# Note: uv and the UV_* settings come from the base image.
FROM quay.io/cdis/amazonlinux-base:${AZLINUX_BASE_VERSION} AS base
ARG SERVICE_NAME


COPY --from=dbmatebin /usr/local/bin/dbmate /usr/local/bin/dbmate

# OpenTelemetry environment variables
ENV OTEL_SERVICE_NAME=${SERVICE_NAME} \
    OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy.monitoring:4318 \
    OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Copy shared libraries
COPY --chown=gen3:gen3 /libraries /libraries

# Copy the selected service.  Some services include database migrations while
# others do not, so copying the service directory keeps this shared Dockerfile
# compatible with every service.
COPY --chown=gen3:gen3 /services/${SERVICE_NAME} /services/${SERVICE_NAME}

COPY --chown=gen3:gen3 /deployments/k8s/services/${SERVICE_NAME}/dockerrun.bash /services/dockerrun.bash

# Conditionally copy db folder if it exists in build context
# The wildcard prevents Docker from failing if db folder is missing
COPY --chown=gen3:gen3 /services/${SERVICE_NAME}/db* /services/${SERVICE_NAME}/db/

WORKDIR /services/${SERVICE_NAME}

# Builder stage installs dependencies
FROM base AS builder
ARG SERVICE_NAME

# `common` is a path dependency of every service, so it must be present to resolve the lock.
COPY --chown=gen3:gen3 /libraries /libraries
COPY --chown=gen3:gen3 /services/${SERVICE_NAME}/pyproject.toml /services/${SERVICE_NAME}/pyproject.toml
COPY --chown=gen3:gen3 /services/${SERVICE_NAME}/uv.lock /services/${SERVICE_NAME}/uv.lock

# Dependencies before the project itself, so editing service code reuses this layer.
# locked and frozen ensure lock file is not modified (e.g.
# exact deps are installed as listed)
RUN uv sync -vv --no-dev --all-extras --frozen --no-install-project

COPY --chown=gen3:gen3 /services/${SERVICE_NAME}/src /services/${SERVICE_NAME}/src

# Installs the service itself on top of the cached dependency layer.
RUN uv sync --no-dev --all-extras --frozen

# Final stage: minimal runtime setup
FROM base
ARG SERVICE_NAME
ARG TARGETARCH

# uv installs the service as an editable package, so /venv holds a .pth pointing back at this
# src tree and both are needed at runtime. /libraries is not: `common` is a built wheel in /venv.
COPY --from=builder /venv /venv
COPY --from=builder /services/${SERVICE_NAME} /services/${SERVICE_NAME}

COPY --chown=gen3:gen3 /deployments/k8s/services/${SERVICE_NAME}/dockerrun.bash /services/dockerrun.bash

USER root
RUN mkdir -p /var/log/nginx && chown -R gen3:gen3 /var/log/nginx \
    && case "${TARGETARCH}" in \
         amd64|arm64) dbmate_arch="${TARGETARCH}" ;; \
         *) echo "Unsupported architecture for dbmate: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl --fail --location --silent --show-error \
         "https://github.com/amacneil/dbmate/releases/download/v2.29.0/dbmate-linux-${dbmate_arch}" \
         --output /usr/local/bin/dbmate \
    && chmod +x /usr/local/bin/dbmate

# Switch to non-root user 'gen3' for the serving process
USER gen3

# The base image already selects the non-root gen3 user for the serving process.
# So don't mess with USER at all
CMD ["/bin/bash", "-c", "/services/dockerrun.bash"]
