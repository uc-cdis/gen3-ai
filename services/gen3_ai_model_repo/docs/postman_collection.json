    {
      "name": "Upload APIs",
      "item": [
        {
          "name": "Multipart Upload",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "revision_name", "value": "{{revision}}", "type": "text"},
                {"key": "files", "type": "file", "src": "{{upload_file_path}}"}
              ]
            },
            "url": "{{base_url}}/api/models/{{namespace}}/{{repo}}/upload"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Multipart upload response fields exist', function () { const json = pm.response.json(); pm.expect(json).to.have.property('status'); pm.expect(json).to.have.property('repo'); pm.expect(json).to.have.property('revision'); pm.expect(json).to.have.property('files'); pm.expect(json).to.have.property('total_size'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate Upload URL",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"revision_name\":\"{{revision}}\",\"file_name\":\"model.safetensors\"}"
            },
            "url": "{{base_url}}/api/models/{{namespace}}/{{repo}}/upload-url"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Upload URL response fields exist', function () { const json = pm.response.json(); pm.expect(json).to.have.property('upload_url'); pm.expect(json).to.have.property('object_key'); });",
                  "const json = pm.response.json(); pm.environment.set('upload_url', json.upload_url); pm.environment.set('object_key', json.object_key);"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload File To Presigned URL",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/octet-stream"}
            ],
            "body": {
              "mode": "file",
              "file": {
                "src": "{{upload_file_path}}"
              }
            },
            "url": "{{upload_url}}",
            "description": "Use the exact upload_url from the previous step. Do not add Authorization headers and do not change host/query params."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 204', function () { pm.expect([200,204]).to.include(pm.response.code); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete Upload",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"revision_name\":\"{{revision}}\",\"revision_identifier\":\"sha-123\",\"etag\":\"etag-123\"}"
            },
            "url": "{{base_url}}/api/models/{{namespace}}/{{repo}}/complete-upload"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
