{
  "info": {
    "name": "Gen3 AI Model Repository API",
    "_postman_id": "4f1d5f89-2a88-4c8f-9a3f-9a7c2c6c5d1a",
    "description": "Validated against the current FastAPI implementation and OpenAPI spec for gen3_ai_model_repo.",
