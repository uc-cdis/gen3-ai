  "item": [
    {
      "name": "Repository APIs",
      "item": [
        {
          "name": "Create Repository",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"description\":\"Production repository\",\"tags\":[\"prod\"]}"
            },
            "url": "{{base_url}}/api/models/{{namespace}}/{{repo}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Repository metadata schema fields exist', function () { const json = pm.response.json(); pm.expect(json).to.have.property('namespace'); pm.expect(json).to.have.property('repo'); pm.expect(json).to.have.property('description'); pm.expect(json).to.have.property('tags'); pm.expect(json).to.have.property('created_at'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List Repositories",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{base_url}}/api/models?namespace={{namespace}}&search={{search}}",
              "host": ["{{base_url}}"],
              "path": ["api", "models"],
              "query": [
                {"key": "namespace", "value": "{{namespace}}"},
                {"key": "search", "value": "{{search}}"}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Repository",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{base_url}}/api/models/{{namespace}}/{{repo}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has repository info schema fields', function () { const json = pm.response.json(); pm.expect(json).to.have.property('id'); pm.expect(json).to.have.property('sha'); pm.expect(json).to.have.property('etag'); pm.expect(json).to.have.property('size'); pm.expect(json).to.have.property('files'); pm.expect(json).to.have.property('metadata'); pm.expect(json).to.have.property('security_status'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Repository",
          "request": {
            "method": "DELETE",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": "{{base_url}}/api/models/{{namespace}}/{{repo}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Has delete response fields', function () { const json = pm.response.json(); pm.expect(json).to.have.property('status'); pm.expect(json).to.have.property('repo'); });"
                ]
              }
            }
          ]
        }
      ]
    },
