# Example test configuration for the gen3_embeddings test suite.
#
# Every value below has a working default, so the tests run without this file at all
# (see tests/conftest.py). Copy this to `tests/.env` only to override for your machine:
#
#     cp tests/.env.example tests/.env
#
# `tests/.env` is git-ignored, so your local overrides stay local.

# Postgres the tests connect to. The admin user must be a SUPERUSER, because the test
# fixtures create/drop databases and roles and the migrations create the `vector`
# extension. Requires a pgvector-enabled Postgres.
# Defaults fall back to PGHOST / PGPORT / PGUSER / PGPASSWORD, then to the values here.
TEST_PGHOST=localhost
TEST_PGPORT=5432
TEST_PGADMIN_USER=postgres
TEST_PGADMIN_PASSWORD=postgres

# Application settings the tests run under.
DEBUG=True
VERBOSE_INTERNAL_LOGS=True
DEBUG_SKIP_AUTH=True

# Set to 1/true/yes to keep the scratch test database after the run, for debugging.
KEEP_TEST_DB=False
